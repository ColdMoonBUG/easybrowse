# 复制为 .env 后按需修改
# 服务监听（刻意避开 8080 这类常被扫描的端口）
PORT=28471
HOST=0.0.0.0

# 用户访问的是 https 地址时设为 1（登录 Cookie 会带 Secure）
BEHIND_HTTPS=0

# 会话签名密钥，留空则自动生成到 data/.session_secret
SESSION_SECRET=

# 数据目录（数据库、用户 profile、日志）
DATA_DIR=./data

# 浏览器内核路径，留空则自动探测 Chrome / Edge
CHROME_PATH=C:/Program Files/Google/Chrome/Application/chrome.exe

# 远端浏览器的出口：留空=跟随本机系统代理 / TUN；填 http://127.0.0.1:10808 则强制走该代理
CHROME_PROXY=

# 额外 Chrome 启动参数（空格分隔），一般留空
CHROME_EXTRA_ARGS=

# 拦截远端浏览器访问回环 / 内网地址，公网部署务必保持 1
BLOCK_PRIVATE_NETWORK=1

# 对外访问地址，仅用于启动日志提示
PUBLIC_URL=

# 可选：本机直接提供 HTTPS（frp 只做 TCP 透传）
# TLS_CERT=./data/tls/fullchain.pem
# TLS_KEY=./data/tls/privkey.pem
# TLS_PORT=28472

# 首次启动创建的管理员初始密码，仅初始化时生效；留空则随机生成并打印
ADMIN_INITIAL_PASSWORD=

# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# 登录态有效期（小时）
SESSION_TTL_HOURS=12

# WebSocket 短时票据有效期（秒）
TICKET_TTL_SECONDS=120

# 自助注册限流：每小时允许的注册数，默认 30，0 = 不限制。
# 注意经 frp 的 tcp 映射时拿不到真实客户端 IP（全都是 127.0.0.1），
# 所以这里的「每 IP」实际退化成「全站共享」，按分享规模调。
REGISTER_LIMIT_PER_HOUR=30

# /nowapi：返回本机 v2rayN 当前选中的代理节点（留空则自动探测常见安装目录）
V2RAYN_DIR=

# /nowapi 鉴权：默认只认登录令牌 —— Authorization: Bearer <token>（或浏览器 eb_sid Cookie）。
# 令牌就是 /api/auth/login 返回的 token，走 auth_sessions 校验，
# 用户被停用 / 删号 / 退出登录后立刻失效。

# 静态口令回退：1 = 额外接受 ?token=<口令> 或请求头 X-Nowapi-Token。
# 这是给「无法走登录流程」的机器对机器调用留的后门：知道这串固定字符就能取节点，
# 绕过账号体系（禁号、停用都拦不住），只能靠轮换口令。默认关闭。
NOWAPI_ALLOW_STATIC_TOKEN=0

# 静态口令本体，仅在前一项为 1 时生效。
# 生成方式：node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
NOWAPI_TOKEN=

# 信任几跳反向代理（决定 req.ip 怎么算）。
# 经 Caddy / Nginx 反代时填 1；直接用 frp 的 tcp 映射（纯透传、不写 X-Forwarded-For）也填 1，
# 此时所有外部请求都算 127.0.0.1。千万别填 true —— 那等于采信任意伪造的 X-Forwarded-For，
# 注册限流和登录锁定会全部失效。
TRUST_PROXY=1

# 极简模式：1 = 只开放 /nowapi 与 /api/auth/* 认证接口，其余页面 / 接口 / WebSocket 全部 404
# 开机自启与 frpc 托管照常工作；改回 0 重启即恢复完整平台
NOWAPI_ONLY=0
